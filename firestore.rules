rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string && data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 8)) &&
        (!('accountSize' in data) || (data.accountSize is number)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTradingAccount(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
        data.startingBalance is number &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('broker' in data) || (data.broker is string && data.broker.size() <= 64)) &&
        (!('accountType' in data) || (data.accountType in ['CASH', 'MARGIN', 'PROP_FIRM', 'CRYPTO', 'FUTURES'])) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 8)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTrade(data, userId) {
      return data.userId == userId &&
        data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 32 &&
        (data.side == 'LONG' || data.side == 'SHORT') &&
        (data.assetClass == 'STOCKS' || data.assetClass == 'OPTIONS' || data.assetClass == 'CRYPTO' || data.assetClass == 'FOREX' || data.assetClass == 'FUTURES') &&
        data.entryDate is string && data.entryDate.size() <= 64 &&
        data.entryPrice is number &&
        data.quantity is number &&
        data.netPnl is number &&
        (data.status == 'WIN' || data.status == 'LOSS' || data.status == 'BREAKEVEN' || data.status == 'OPEN') &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 128)) &&
        (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 64)) &&
        (!('exitDate' in data) || (data.exitDate is string && data.exitDate.size() <= 64)) &&
        (!('exitPrice' in data) || (data.exitPrice is number)) &&
        (!('grossPnl' in data) || (data.grossPnl is number)) &&
        (!('fees' in data) || (data.fees is number)) &&
        (!('pnlPercent' in data) || (data.pnlPercent is number)) &&
        (!('stopLoss' in data) || (data.stopLoss is number)) &&
        (!('takeProfit' in data) || (data.takeProfit is number)) &&
        (!('setup' in data) || (data.setup is string && data.setup.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('mistakes' in data) || (data.mistakes is string && data.mistakes.size() <= 256)) &&
        (!('rating' in data) || (data.rating is number)) &&
        (!('chartUrl' in data) || (data.chartUrl is string && data.chartUrl.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Trading Accounts Subcollection
      match /accounts/{accountId} {
        allow get: if isOwner(userId) && isValidId(accountId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidTradingAccount(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(accountId) &&
          isValidTradingAccount(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // User Trades Subcollection
      match /trades/{tradeId} {
        allow get: if isOwner(userId) && isValidId(tradeId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tradeId) && isValidTrade(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(tradeId) &&
          isValidTrade(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(tradeId);
      }
    }
  }
}
